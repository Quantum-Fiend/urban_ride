{
  "info": {
    "name": "Urban Ride (RideSphere) API Collection",
    "description": "Production-grade RESTful API collection for Urban Ride platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.rider@ridesphere.io\",\n  \"password\": \"P@ssword123\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Vance\",\n  \"phoneNumber\": \"+15550192834\",\n  \"role\": \"RIDER\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"]}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.rider@ridesphere.io\",\n  \"password\": \"P@ssword123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]}
          }
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "Fare Estimate",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupLatitude\": 12.9716,\n  \"pickupLongitude\": 77.5946,\n  \"dropoffLatitude\": 12.9352,\n  \"dropoffLongitude\": 77.6245\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/trips/estimate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "trips", "estimate"]}
          }
        },
        {
          "name": "Request Ride",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupLatitude\": 12.9716,\n  \"pickupLongitude\": 77.5946,\n  \"dropoffLatitude\": 12.9352,\n  \"dropoffLongitude\": 77.6245,\n  \"pickupAddress\": \"MG Road Metro, Bengaluru\",\n  \"dropoffAddress\": \"Koramangala 5th Block\",\n  \"tier\": \"COMFORT\",\n  \"paymentMethod\": \"WALLET\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/trips/request", "host": ["{{baseUrl}}"], "path": ["api", "v1", "trips", "request"]}
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "jwtToken", "value": ""}
  ]
